# Modelo das variáveis de ambiente. NÃO coloque valores reais aqui.
# Os valores reais são configurados no painel da Vercel e nunca vão para o GitHub.

# Supabase (públicas: podem aparecer no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SECRETA: só no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (SECRETAS: só no servidor)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Endereço público do site
NEXT_PUBLIC_SITE_URL=
